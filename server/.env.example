PORT=5000
NODE_ENV=development

# Turso distributed SQLite configuration
# For local SQLite file (default for development):
TURSO_DATABASE_URL="file:cnds.db"
TURSO_AUTH_TOKEN=""

# For Turso Cloud (production on Vercel):
# TURSO_DATABASE_URL="libsql://cnds-burundi-your-org.turso.io"
# TURSO_AUTH_TOKEN="your-turso-auth-token"

# JWT Authentication Secret
JWT_SECRET="cnds-super-secure-jwt-secret-replace-in-production-burundi-2024"
JWT_EXPIRES_IN="8h"

# CORS configuration
CLIENT_URL="http://localhost:5173"

# SMTP Email Configuration (pour l'envoi réel des emails de newsletter)
# Option A : Gmail (avec mot de passe d'application)
SMTP_SERVICE="gmail"
SMTP_USER="votre-email@gmail.com"
SMTP_PASS="votre-mot-de-passe-d-application-16-caracteres"
SMTP_FROM="CNDS Burundi <votre-email@gmail.com>"

# Option B : Serveur SMTP standard (Brevo, Resend, ou SMTP CNDS officiel)
# SMTP_HOST="smtp-relay.brevo.com"
# SMTP_PORT=587
# SMTP_USER="votre-identifiant"
# SMTP_PASS="votre-cle-smtp"
# SMTP_FROM="CNDS Burundi <contact@cndsburundi.bi>"
