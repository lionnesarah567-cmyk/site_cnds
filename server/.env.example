PORT=5000
NODE_ENV=development

# Turso distributed SQLite configuration
# For local SQLite file (default for development):
TURSO_DATABASE_URL="file:cnds.db"
TURSO_AUTH_TOKEN=""

# For Turso Cloud (production on Vercel):
# TURSO_DATABASE_URL="libsql://cnds-burundi-your-org.turso.io"
# TURSO_AUTH_TOKEN="your-turso-auth-token"

# JWT Authentication Secret
JWT_SECRET="cnds-super-secure-jwt-secret-replace-in-production-burundi-2024"
JWT_EXPIRES_IN="8h"

# CORS configuration
CLIENT_URL="http://localhost:5173"
